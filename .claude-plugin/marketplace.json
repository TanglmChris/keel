{
  "name": "keel-marketplace",
  "owner": {
    "name": "TanglmChris"
  },
  "plugins": [
    {
      "name": "keel",
      "version": "5.73.1",
      "source": {
        "source": "npm",
        "package": "@christang/keel",
        "version": "5.73.1"
      },
      "description": "Keel OpenSpec execution discipline: stateless continuity, task capsules, deterministic gates, and expectation alignment for Codex and Claude Code.",
      "skills": [
        "./plugins/keel/skills/"
      ],
      "agents": [
        "./plugins/keel/agents/keel-single-task-goal-claude.md"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node",
                "args": [
                  "${CLAUDE_PLUGIN_ROOT}/plugins/keel/scripts/session-start.js"
                ],
                "timeout": 15
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "Edit|Write|NotebookEdit",
            "hooks": [
              {
                "type": "command",
                "command": "node",
                "args": [
                  "${CLAUDE_PLUGIN_ROOT}/plugins/keel/scripts/pretooluse-guard.js"
                ],
                "timeout": 10
              }
            ]
          }
        ]
      }
    }
  ]
}
